# HirelyStreet environment variables
# Copy this file to .env and supply real values.
# Never commit .env to version control.

# ============================================================
# Supabase waitlist persistence
# ============================================================
# Your Supabase project URL (e.g. https://xyzxyz.supabase.co)
SUPABASE_URL=

# Service role key, used only server-side and never in the frontend
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Resend investor inquiry email
# ============================================================
# API key from https://resend.com
RESEND_API_KEY=

# Sender address configured and verified in Resend. For production, verify
# your domain and use an address on that domain.
RESEND_FROM_EMAIL=

# Investor inquiry recipient. Defaults to founders@hirelystreet.com when unset.
SUBMISSION_NOTIFICATION_EMAIL=founders@hirelystreet.com

# ============================================================
# Server config
# ============================================================
PORT=3001

# Frontend origin for CORS (development)
FRONTEND_URL=http://localhost:5173
